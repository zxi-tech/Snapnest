<Window x:Class="Snapnest.App.Views.Capture.CaptureDecisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screenshot Captured" Height="400" Width="350"
        WindowStartupLocation="CenterScreen" WindowStyle="ToolWindow"
        Background="{StaticResource AppBackgroundBrush}" ResizeMode="NoResize">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="What would you like to do?" FontSize="16" FontWeight="SemiBold" 
                   Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Image Preview -->
        <Border Grid.Row="1" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                Background="{StaticResource CardBackgroundBrush}" Margin="0,0,0,15" ClipToBounds="True">
            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="5"/>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Vertical">
            <Button x:Name="BtnSaveNormally" Content="1. Save Normally (Pictures Folder)" Padding="10,8" Margin="0,0,0,8" 
                    Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnSaveNormally_Click"/>
            
            <Button x:Name="BtnAddToClothesline" Content="2. Add to Snapnest Library" Padding="10,8" Margin="0,0,0,8" 
                    Background="{StaticResource CardBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}" BorderThickness="1" Cursor="Hand" Click="BtnAddToClothesline_Click"/>
            
            <Button x:Name="BtnDiscard" Content="3. Discard" Padding="10,8" 
                    Background="#FFE0E0" Foreground="#D00000" BorderThickness="0" Cursor="Hand" Click="BtnDiscard_Click"/>
        </StackPanel>
    </Grid>
</Window>