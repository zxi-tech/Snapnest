<UserControl x:Class="Snapnest.App.Views.ClotheslinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:entities="clr-namespace:Snapnest.Core.Entities;assembly=Snapnest.Core">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="My Clotheslines" FontSize="28" FontWeight="SemiBold" 
                   Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,20"/>

        <!-- Form Tambah Data -->
        <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" 
                CornerRadius="8" Padding="16" Margin="0,0,0,20"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <TextBox Grid.Column="0" Text="{Binding NewClotheslineName, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="10,8" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                
                <Button Grid.Column="1" Content="Add Clothesline" 
                        Command="{Binding CreateClotheslineCommand}"
                        Background="{StaticResource AccentBrush}" Foreground="White"
                        Padding="16,8" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Daftar Clothesline -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Clotheslines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type entities:Clothesline}">
                        <Border Background="{StaticResource CardBackgroundBrush}" 
                                CornerRadius="8" Padding="16" Margin="0,0,0,10"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="16" 
                                           FontWeight="Medium" VerticalAlignment="Center"
                                           Foreground="{StaticResource PrimaryTextBrush}"/>
                                
                                <Button Grid.Column="1" Content="Delete" 
                                        Command="{Binding DataContext.DeleteClotheslineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="#FFE0E0" Foreground="#D00000"
                                        Padding="12,6" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>